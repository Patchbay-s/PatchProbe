{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PatchProbe",
  "version": "1.0.0",
  "identifier": "com.patchbay.patchprobe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PatchProbe",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright © 2026 PatchProbe contributors. Licensed under GPL-3.0."
  }
}
