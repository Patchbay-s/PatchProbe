# Copy to `.env` (git-ignored) or define these as GitHub Actions secrets.
# No signing identity, certificate or password may ever be committed to this repository.
# Variable names are the ones read natively by `tauri build` (Tauri 2).

# --- macOS code signing ("Developer ID Application" certificate) -----------------------
# Full identity name, e.g. "Developer ID Application: Jane Doe (TEAMID1234)"
APPLE_SIGNING_IDENTITY=
# CI only: base64-encoded .p12 certificate and its password
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# --- macOS notarization (Apple ID + app-specific password) -----------------------------
APPLE_ID=
# App-specific password (appleid.apple.com > Sign-In and Security)
APPLE_PASSWORD=
APPLE_TEAM_ID=
# Alternative: App Store Connect API key (instead of APPLE_ID / APPLE_PASSWORD)
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# --- Tauri updater signing (only if the updater plugin is ever enabled) ----------------
# Generated with `npm run tauri signer generate`; never commit the private key.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- Windows Authenticode signing (optional) -------------------------------------------
# SHA-1 thumbprint of a certificate installed in the Windows certificate store, passed to
# bundle.windows.certificateThumbprint at build time (do not commit it).
WINDOWS_CERTIFICATE_THUMBPRINT=
